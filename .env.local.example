NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com

# Інтеграція з системою «Карма» Генеалогічного навігатора (https://www.uagenealogy.com)
# Токен видає адмін Навігатора. Серверний секрет — НЕ додавайте префікс NEXT_PUBLIC_.
KARMA_TOKEN=your-karma-token
# Секрет для захисту нічного cron-ендпоінта /api/karma/ingest-cron.
# Нічний запуск — через GitHub Actions; те саме значення додайте у GitHub Secrets (CRON_SECRET).
CRON_SECRET=your-cron-secret
